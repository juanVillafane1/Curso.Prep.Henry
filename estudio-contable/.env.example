# ---------- Base de datos ----------
POSTGRES_USER=estudio
POSTGRES_PASSWORD=estudio
POSTGRES_DB=estudio_contable
DATABASE_URL=postgresql://estudio:estudio@localhost:5432/estudio_contable?schema=public

# ---------- API ----------
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
UPLOADS_DIR=./uploads
TZ=America/Argentina/Buenos_Aires

# ---------- Reglas de negocio (parametrizables) ----------
IVA_DIFERIDO_MESES=3
RECORDATORIO_DIAS_ANTES=3,2
ARCA_DIAS_REINTENTO_DEBITO=10
CHEQUE_DIAS_VALIDEZ=30

# ---------- WhatsApp (Meta Cloud API) ----------
# WHATSAPP_DRIVER=console | meta
WHATSAPP_DRIVER=console
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_vencimiento
WHATSAPP_TEMPLATE_LANG=es_AR

# ---------- Jobs (cron, hora local) ----------
CRON_RECORDATORIOS=0 9 * * 1-5
CRON_CUOTAS_DEBITO=0 7 * * *
CRON_RESUMEN_SEMANAL=0 8 * * 1
CRON_MARCAR_VENCIDOS=30 0 * * *

# ---------- Web ----------
# URL de la API vista desde el servidor de Next (el navegador usa el proxy /api/v1)
API_URL=http://localhost:4000/api/v1
