{
  "name": "@estudio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "worker": "tsx watch --env-file=../../.env src/jobs/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@estudio/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "node-cron": "4.6.0",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "dotenv-cli": "8.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
